{
  "name": "qc-lab",
  "version": "2.7.6",
  "description": "QC Lab - Nội kiểm chất lượng xét nghiệm (IQC) cho phòng xét nghiệm lâm sàng",
  "author": "QC Lab",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "npm run build:pilot && vite",
    "build:pilot": "vite build && npm run build:core && npm run build:worker && npm run build:react",
    "build:core": "vite build --config vite.core.config.mjs",
    "build:react": "vite build --config vite.react.config.mjs",
    "build:worker": "tsc -p tsconfig.worker.json",
    "test": "node scripts/run-tests.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.modules.json && tsc -p tsconfig.react.json",
    "app-v2:typecheck": "tsc -p tsconfig.app-v2-main.json --noEmit && tsc -p tsconfig.app-v2-renderer.json",
    "app-v2:test": "node app-v2/scripts/run-tests.cjs",
    "app-v2:build:main": "tsc -p tsconfig.app-v2-main.json",
    "app-v2:build:renderer": "vite build --config vite.app-v2-renderer.config.mjs",
    "app-v2:build": "npm run app-v2:build:main && npm run app-v2:build:renderer",
    "app-v2:start": "npm run app-v2:build && electron app-v2-dist/main/index.js",
    "visual-check": "node scripts/visual-check.js",
    "nce-check": "node scripts/nce-workflow-check.js",
    "ui-check": "node scripts/ui-workflow-check.js",
    "a11y-audit": "node scripts/a11y-audit.js",
    "print-check": "node scripts/print-check.js",
    "coverage-map": "node scripts/coverage-map.js",
    "check-build-freshness": "node benchmarks/check-build-freshness.js",
    "benchmark:10y": "node benchmarks/performance-baseline.js --ten-years",
    "lis:gateway": "node lis-gateway/server.js",
    "lis:config": "node scripts/lis-config.js",
    "verify-release": "node benchmarks/verify-release.js",
    "patch-build": "node scripts/patch-7za-symlink.js",
    "dist": "npm run build:pilot && node scripts/patch-7za-symlink.js && electron-builder --win nsis",
    "dist:publish": "npm run build:pilot && node scripts/patch-7za-symlink.js && electron-builder --win nsis --publish always"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "axe-core": "^4.12.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.61.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "vn.qclab.desktop",
    "productName": "QC Lab",
    "copyright": "QC Lab",
    "publish": {
      "provider": "github",
      "owner": "bosunrang",
      "repo": "qc-lab",
      "releaseType": "release"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "assets/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "QC-Lab-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "QC Lab",
      "installerLanguages": [
        "vi_VN",
        "en_US"
      ]
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "firebase": "^12.18.0"
  }
}
