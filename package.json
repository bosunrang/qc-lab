{
  "name": "qc-lab",
  "version": "2.6.1",
  "description": "QC Lab - Nội kiểm chất lượng xét nghiệm (IQC) cho phòng xét nghiệm lâm sàng",
  "author": "QC Lab",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node scripts/run-tests.js",
    "typecheck": "tsc --noEmit",
    "visual-check": "node scripts/visual-check.js",
    "nce-check": "node scripts/nce-workflow-check.js",
    "a11y-audit": "node scripts/a11y-audit.js",
    "print-check": "node scripts/print-check.js",
    "coverage-map": "node scripts/coverage-map.js",
    "benchmark:10y": "node benchmarks/performance-baseline.js --ten-years",
    "lis:gateway": "node lis-gateway/server.js",
    "verify-release": "node benchmarks/verify-release.js",
    "patch-build": "node scripts/patch-7za-symlink.js",
    "dist": "node scripts/patch-7za-symlink.js && electron-builder --win nsis",
    "dist:publish": "node scripts/patch-7za-symlink.js && electron-builder --win nsis --publish always"
  },
  "devDependencies": {
    "axe-core": "^4.12.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.61.1",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "vn.qclab.desktop",
    "productName": "QC Lab",
    "copyright": "QC Lab",
    "publish": {
      "provider": "github",
      "owner": "bosunrang",
      "repo": "qc-lab",
      "releaseType": "release"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "assets/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "QC-Lab-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "QC Lab",
      "installerLanguages": [
        "vi_VN",
        "en_US"
      ]
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
