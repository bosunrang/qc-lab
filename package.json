{
  "name": "qc-lab",
  "version": "1.0.3",
  "description": "QC Lab - Nội kiểm chất lượng xét nghiệm (IQC) cho phòng xét nghiệm lâm sàng",
  "author": "QC Lab",
  "license": "UNLICENSED",
  "private": true,
  "main": "app-dist/main/index.js",
  "scripts": {
    "start": "npm run build && electron .",
    "dev": "npm run app:dev",
    "build": "npm run app:build",
    "test": "npm run app:test",
    "test:performance": "npm run app:build:main && node --test app/tests/large-dataset-performance.perf.mjs",
    "typecheck": "npm run app:typecheck",
    "app:typecheck": "tsc -p tsconfig.app-main.json --noEmit && tsc -p tsconfig.app-renderer.json",
    "app:test": "node app/scripts/run-tests.cjs",
    "app:build:main": "tsc -p tsconfig.app-main.json",
    "app:build:renderer": "vite build --config vite.app-renderer.config.mjs",
    "app:build": "npm run app:build:main && npm run app:build:renderer",
    "app:dev": "vite --config vite.app-renderer.config.mjs",
    "app:css-parity": "node app/scripts/css-parity-check.cjs",
    "verify-release": "npm run typecheck && npm test && npm run app:css-parity && npm run build",
    "patch-build": "node scripts/patch-7za-symlink.js",
    "dist": "npm run app:build && node scripts/patch-7za-symlink.js && electron-builder --win nsis",
    "dist:publish": "npm run app:build && node scripts/patch-7za-symlink.js && electron-builder --win nsis --publish always"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/sql.js": "^1.4.11",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "sql.js": "^1.14.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "vn.qclab.desktop",
    "productName": "QC Lab",
    "copyright": "QC Lab",
    "publish": {
      "provider": "github",
      "owner": "bosunrang",
      "repo": "qc-lab",
      "releaseType": "release"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "app-dist/**/*",
      "build/icon.png",
      "!app-dist/renderer/assets/*.wasm",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "QC-Lab-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "QC Lab",
      "installerLanguages": [
        "vi_VN",
        "en_US"
      ]
    }
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  }
}
