{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["es2020", "dom"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true
  },
  "include": ["assets/**/*.js", "global.d.ts"],
  "exclude": ["node_modules", "dist", "build", "assets/workers/**"]
}
