{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "commonjs",
    "strict": true,
    "noEmitOnError": true,
    "rootDir": "app-v2/main",
    "outDir": "app-v2-dist/main",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": ["app-v2/main/**/*.ts"]
}
